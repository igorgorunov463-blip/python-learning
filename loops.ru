# 1. Цикл for (когда мы знаем, сколько раз нужно повторить)
print("--- Счетчик месяцев до переезда ---")

# range(1, 6) создает последовательность чисел от 1 до 5 (6 не включается)
for month in range(1, 6):
    print(f"Прошел месяц {month}. Учу Python!")

print("Ура, 5 месяцев пролетели!\n")


# 2. Цикл while (когда мы не знаем точно, сколько раз повторять, и ждем условия)
print("--- Проверка пароля ---")

# Мы задаем правильный пароль
correct_password = "python2026"
user_password = ""

# Пока введенный пароль НЕ равен правильному, цикл будет работать
while user_password != correct_password:
    user_password = input("Введи секретный пароль: ")
    
    if user_password != correct_password:
        print("Неверно! Попробуй еще раз.")

print("Доступ разрешен! Добро пожаловать в систему.\n")


# 3. Полезный цикл для списков (массивов данных)
print("--- Мой список задач на сегодня ---")

tasks = ["Посмотреть урок по Python", "Написать код", "Закоммитить на GitHub", "Выпить кофе"]

# Мы проходим по каждому элементу списка tasks и называем его task
for task in tasks:
    print("Задача:", task)

print("Все задачи выполнены!")